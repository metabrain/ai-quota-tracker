# /etc/ai-quota-tracker/keys.env — example
# chmod 600, owned by the service user (e.g. `aiquota`).
# Loaded by the systemd unit via EnvironmentFile=.

OPENAI_API_KEY=
OPENAI_GRANTED_USD=120

# Claude subscription windows (5h + weekly) via the OAuth usage endpoint.
# Token precedence: CLAUDE_CODE_OAUTH_TOKEN, then ANTHROPIC_OAUTH_TOKEN,
# then ~/.claude/.credentials.json (from `claude login`).
CLAUDE_CODE_OAUTH_TOKEN=

# Codex (ChatGPT subscription) via the CLI's own OAuth credentials.
# Read from ~/.codex/auth.json (set by `codex login`, ChatGPT flow).
# Optional overrides:
# CODEX_HOME=/home/aiquota/.codex
# CODEX_ACCESS_TOKEN=
# CODEX_ACCOUNT_ID=
# CODEX_BASE_URL=https://chatgpt.com/backend-api

# Muse Code: the daemon detects the `muse login` session read-only
# (MUSE_AUTH_PATH, then $XDG_CONFIG_HOME/muse/auth.json, then
# ~/.config/muse/auth.json). Muse exposes no quota API, so the provider
# reports sign-in/billing state, never synthetic quota data.
# MUSE_AUTH_PATH=/home/aiquota/.config/muse/auth.json
# META_API_KEY moves Muse onto per-token Model API billing, ahead of the
# stored subscription session. Leave unset to stay on the subscription.

# Flip to 0 once real keys are set; demo metrics are only a stand-in.
QUOTA_DEMO_MODE=0
